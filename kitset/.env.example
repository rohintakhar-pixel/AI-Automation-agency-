# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git and must never be committed.

# --- Stripe (test mode while you are testing) ---
# Secret key. Starts with sk_test_ in test mode.
STRIPE_SECRET_KEY=

# Webhook signing secret for the /api/webhook endpoint. Starts with whsec_
STRIPE_WEBHOOK_SECRET=

# The Stripe price ID for the Shopify support drafter bot. Starts with price_
# The name of this variable is set in catalog/shopify-support-drafter/bot.json
# under "stripePriceIdEnv". Change it there if you rename this.
STRIPE_PRICE_SHOPIFY_SUPPORT_DRAFTER=

# --- Site ---
# The full public address of the site, no trailing slash.
# Local testing: http://localhost:3000
# On Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
